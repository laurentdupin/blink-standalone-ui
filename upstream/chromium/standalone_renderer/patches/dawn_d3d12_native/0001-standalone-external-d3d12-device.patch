+MaybeError ValidateRequestOptions(const UnpackedPtr<RequestAdapterOptions>& options,
+                                  IDXGIFactory4* factory,
+                                  ComPtr<IDXGIAdapter>* dxgiAdapter,
+                                  ComPtr<ID3D12Device>* d3d12Device,
+                                  ComPtr<ID3D12CommandQueue>* d3d12CommandQueue) {
+    auto* d3d12DeviceOption = options.Get<RequestAdapterOptionsD3D12Device>();
+    if (!d3d12DeviceOption) {
+        return {};
+    }
+
+    DAWN_INVALID_IF(!d3d12DeviceOption->device,
+                    "RequestAdapterOptionsD3D12Device::device is null.");
+    DAWN_INVALID_IF(!d3d12DeviceOption->commandQueue,
+                    "RequestAdapterOptionsD3D12Device::commandQueue is null.");
+
+    ComPtr<ID3D12Device> queueDevice;
+    DAWN_TRY(CheckHRESULT(
+        d3d12DeviceOption->commandQueue->GetDevice(IID_PPV_ARGS(&queueDevice)),
+        "D3D12 command queue GetDevice"));
+
+    ComPtr<IUnknown> optionDeviceIdentity;
+    ComPtr<IUnknown> queueDeviceIdentity;
+    DAWN_TRY(CheckHRESULT(d3d12DeviceOption->device.As(&optionDeviceIdentity),
+                          "D3D12 device QueryInterface IUnknown"));
+    DAWN_TRY(CheckHRESULT(queueDevice.As(&queueDeviceIdentity),
+                          "D3D12 queue device QueryInterface IUnknown"));
+    DAWN_INVALID_IF(optionDeviceIdentity.Get() != queueDeviceIdentity.Get(),
+                    "RequestAdapterOptionsD3D12Device device and commandQueue do not belong to "
+                    "the same ID3D12Device.");
+
+    LUID adapterLuid = d3d12DeviceOption->device->GetAdapterLuid();
+    if (auto* luidOptions = options.Get<d3d::RequestAdapterOptionsLUID>()) {
+        DAWN_INVALID_IF(
+            memcmp(&adapterLuid, &luidOptions->adapterLUID, sizeof(LUID)) != 0,
+            "RequestAdapterOptionsLUID and RequestAdapterOptionsD3D12Device don't match.");
+    }
+
+    ComPtr<IDXGIAdapter1> adapter;
+    DAWN_TRY(CheckHRESULT(factory->EnumAdapterByLuid(adapterLuid, IID_PPV_ARGS(&adapter)),
+                          "EnumAdapterByLuid"));
+
+    *dxgiAdapter = std::move(adapter);
+    *d3d12Device = d3d12DeviceOption->device;
+    *d3d12CommandQueue = d3d12DeviceOption->commandQueue;
+
+    return {};
+}
