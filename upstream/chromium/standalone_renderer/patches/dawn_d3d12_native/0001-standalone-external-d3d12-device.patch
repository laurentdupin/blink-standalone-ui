+    RequestAdapterOptionsD3D12Device() {
+        sType = static_cast<wgpu::SType>(0x0005FF12);
+    }
+
+    Microsoft::WRL::ComPtr<ID3D12Device> device;
+    Microsoft::WRL::ComPtr<ID3D12CommandQueue> commandQueue;
