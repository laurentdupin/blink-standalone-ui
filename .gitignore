# Local build products
/build/
/out/
/cmake-build-*/
/dist/
/npm-cache/
/.vs/
/.vscode/

# The exported tree keeps only the generated files and command metadata from
# Chromium's out directory. Local object files and executables must stay out.
/upstream/chromium/out/**
!/upstream/chromium/generated/blink_live/
!/upstream/chromium/generated/blink_live/gen/
!/upstream/chromium/generated/blink_live/gen/**
!/upstream/chromium/generated/blink_live/*.rsp
!/upstream/chromium/generated/blink_live/*.commands.txt

# Compiler/linker products
*.obj
*.o
*.lib
*.a
*.dll
*.dylib
*.so
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.ipdb
*.iobj

# Downloaded archives and generated media artifacts
*.zip
*.7z
*.tar
*.tgz
*.gz
*.png
*.webp
*.mp4

# Generated local scratch files
*.log
*.tmp
*.i
*.rsp
!upstream/chromium/generated/blink_live/*.rsp
*.commands.txt
!upstream/chromium/generated/blink_live/*.commands.txt

# Validation/perf comparison output directories
screenshots/
snapshots/
perf-output/
perf_outputs/
perf-artifacts/
perf_artifacts/
comparison-output/
comparison_outputs/
comparison-results/
comparison_results/

# Python/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
node_modules/
/.tools/gn/

# Editor/OS noise
.DS_Store
Thumbs.db
*.swp
*~
